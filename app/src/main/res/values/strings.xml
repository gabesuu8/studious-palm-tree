    <string name="onboarding_articles_desc">Read easy-to-understand articles about common health conditions like malaria, diarrhea, and more. Search by topic and save your favorites.</string>
    
    <string name="onboarding_growth_title">Child Growth Tracker</string>
    <string name="onboarding_growth_desc">Monitor your child\'s growth with WHO standards. Track weight, height, and detect early signs of malnutrition.</string>
    
    <string name="onboarding_pregnancy_title">Pregnancy Tracker</string>
    <string name="onboarding_pregnancy_desc">Track your pregnancy week by week. Record prenatal visits and learn about danger signs that need immediate attention.</string>
    
    <string name="onboarding_vaccine_title">Vaccination Tracker</string>
    <string name="onboarding_vaccine_desc">Keep track of your child\'s vaccinations. Never miss an important vaccine with our comprehensive immunization schedule.</string>
    
    <string name="onboarding_clinics_title">Find Nearby Clinics</string>
    <string name="onboarding_clinics_desc">Locate hospitals and health centers near you. Get directions, phone numbers, and see which facilities offer emergency care.</string>
    
    <string name="onboarding_offline_title">Works Offline</string>
