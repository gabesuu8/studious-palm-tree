<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Rounded shape (softer corners app-wide) -->
    <style name="ShapeAppearance.App.Rounded.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.App.Rounded.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.App.Rounded.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Theme.HelloApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_500</item>
        <item name="colorPrimaryVariant">@color/teal_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/light_blue_500</item>
        <item name="colorSecondaryVariant">@color/light_blue_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/teal_700</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Rounded.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Rounded.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.Rounded.Large</item>
    </style>
    
    <style name="Theme.HelloApp.NoActionBar" parent="Theme.HelloApp">
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Material AlertDialog styling with app theme colors -->
    <style name="Theme.HelloApp.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/teal_500</item>
        <item name="colorSecondary">@color/teal_700</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Title.Text.HelloApp</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.Body.Text.HelloApp</item>
        <item name="buttonBarPositiveButtonStyle">@style/MaterialAlertDialog.Button.PositiveButton.HelloApp</item>
        <item name="buttonBarNegativeButtonStyle">@style/MaterialAlertDialog.Button.NegativeButton.HelloApp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Dialog.Rounded</item>
    </style>

    <!-- Rounded corners for dialogs -->
    <style name="ShapeAppearance.App.Dialog.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Custom title text style for AlertDialog -->
    <style name="MaterialAlertDialog.Title.Text.HelloApp" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/teal_700</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Custom body text style for AlertDialog -->
    <style name="MaterialAlertDialog.Body.Text.HelloApp" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Custom positive button style for AlertDialog -->
    <style name="MaterialAlertDialog.Button.PositiveButton.HelloApp" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/teal_700</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Custom negative button style for AlertDialog -->
    <style name="MaterialAlertDialog.Button.NegativeButton.HelloApp" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/teal_700</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
