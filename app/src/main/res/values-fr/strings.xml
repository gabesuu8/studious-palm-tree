    <string name="onboarding_welcome_title">Bienvenue dans Guide Santé</string>
    <string name="onboarding_welcome_desc">Votre compagnon santé hors ligne pour les familles en Afrique. Accédez aux informations de santé essentielles à tout moment, n\'importe où — même sans internet.</string>
    
    <string name="onboarding_articles_title">Articles de Santé</string>
    <string name="onboarding_articles_desc">Lisez des articles faciles à comprendre sur les maladies courantes comme le paludisme, la diarrhée, et plus encore. Recherchez par sujet et sauvegardez vos favoris.</string>
    
    <string name="onboarding_growth_title">Suivi de Croissance</string>
    <string name="onboarding_growth_desc">Surveillez la croissance de votre enfant avec les normes OMS. Suivez le poids, la taille et détectez les premiers signes de malnutrition.</string>
    
    <string name="onboarding_pregnancy_title">Suivi de Grossesse</string>
    <string name="onboarding_pregnancy_desc">Suivez votre grossesse semaine par semaine. Enregistrez vos visites prénatales et apprenez les signes de danger nécessitant une attention immédiate.</string>
    
    <string name="onboarding_vaccine_title">Carnet de Vaccination</string>
    <string name="onboarding_vaccine_desc">Suivez les vaccinations de votre enfant. Ne manquez jamais un vaccin important avec notre calendrier de vaccination complet.</string>
    
    <string name="onboarding_clinics_title">Trouver des Cliniques</string>
    <string name="onboarding_clinics_desc">Localisez les hôpitaux et centres de santé près de chez vous. Obtenez les itinéraires, numéros de téléphone et services d\'urgence.</string>
    
    <string name="onboarding_offline_title">Fonctionne Hors Ligne</string>
    <string name="onboarding_offline_desc">Toutes vos données sont stockées en sécurité sur votre appareil. Accédez aux informations de santé et suivez la santé de votre famille même sans connexion internet.</string>
    
