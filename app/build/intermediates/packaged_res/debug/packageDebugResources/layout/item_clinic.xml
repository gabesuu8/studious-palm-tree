<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iconType"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="@drawable/circle_background_teal"
                app:tint="@android:color/white"
                android:src="@drawable/ic_clinic"
                android:contentDescription="@string/clinic_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtClinicName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="CHU Sylvanus Olympio" />

                <TextView
                    android:id="@+id/txtAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="13sp"
                    tools:text="Boulevard du 13 Janvier, Lomé" />

            </LinearLayout>

            <!-- Distance Badge -->
            <TextView
                android:id="@+id/txtDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/distance_badge_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/teal_700"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="2.5 km"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Emergency Badge -->
        <TextView
            android:id="@+id/emergencyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/emergency_badge_background"
            android:drawableStart="@android:drawable/ic_dialog_alert"
            android:drawablePadding="4dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/emergency_24_7"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Services -->
        <TextView
            android:id="@+id/txtServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_services"
            android:drawablePadding="8dp"
            android:textColor="#666666"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Emergency, Surgery, Pediatrics, Maternity"
            tools:visibility="visible" />

        <!-- Hours -->
        <TextView
            android:id="@+id/txtHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableStart="@drawable/ic_clock"
            android:drawablePadding="8dp"
            android:textColor="#666666"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="24/7"
            tools:visibility="visible" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCall"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/call"
                app:icon="@android:drawable/ic_menu_call"
                app:strokeColor="@color/teal_500" />

            <Button
                android:id="@+id/btnDirections"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/teal_500"
                android:text="@string/directions"
                app:icon="@drawable/ic_directions" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
