<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Date & Age Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="4dp"
                android:layout_height="40dp"
                android:background="#009688" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="0dp">

                <TextView
                    android:id="@+id/detailDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="15 Jan 2026" />

                <TextView
                    android:id="@+id/detailAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#757575"
                    android:textSize="13sp"
                    tools:text="Age: 6 months" />

            </LinearLayout>
        </LinearLayout>

        <!-- Nutritional Status Badge -->
        <TextView
            android:id="@+id/detailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/status_badge_background"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            tools:text="Normal" />

        <!-- Measurements Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <!-- Weight -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#F5F5F5"
                android:padding="12dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weight"
                    android:textColor="#757575"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/detailWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#009688"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="7.3 kg" />

                <TextView
                    android:id="@+id/detailWeightZScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#757575"
                    android:textSize="11sp"
                    tools:text="z: -0.12" />

            </LinearLayout>

            <!-- Height -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#F5F5F5"
                android:padding="12dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/height"
                    android:textColor="#757575"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/detailHeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#009688"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="65.0 cm" />

                <TextView
                    android:id="@+id/detailHeightZScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#757575"
                    android:textSize="11sp"
                    tools:text="z: 0.34" />

            </LinearLayout>
        </LinearLayout>

        <!-- BMI row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bmi"
                android:textColor="#757575"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/detailBmi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                tools:text="17.3" />

        </LinearLayout>

        <!-- Head Circumference (optional) -->
        <LinearLayout
            android:id="@+id/detailHeadCircSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/head_circumference"
                android:textColor="#757575"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/detailHeadCirc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                tools:text="43.0 cm (normal: 41-45)" />

        </LinearLayout>

        <!-- MUAC (optional) -->
        <LinearLayout
            android:id="@+id/detailMuacSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/muac"
                android:textColor="#757575"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/detailMuac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                tools:text="14.0 cm → Normal" />

        </LinearLayout>

        <!-- Notes (optional) -->
        <LinearLayout
            android:id="@+id/detailNotesSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notes"
                android:textColor="#757575"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/detailNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textSize="13sp"
                android:paddingTop="2dp"
                tools:text="Some notes here" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
